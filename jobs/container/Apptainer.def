Bootstrap: docker
From: condaforge/miniforge3:latest

%files
    environment.yaml /environment.yaml
    requirements.txt /requirements.txt

%post
    # Update and install necessary packages
    apt-get update && \
        DEBIAN_FRONTEND=noninteractive TZ=Europe/Amsterdam \
        apt-get install -y \
            build-essential \
            ca-certificates \
            git \
            time \
            vim && \
        apt-get clean && rm -rf /var/lib/apt/lists/*

    # Create the conda environment used by the RAVAN experiment scripts.
    mamba env create --quiet --file /environment.yaml
    
    # Clean up
    mamba clean --all -y

    # Activate the conda environment for apptainer exec/shell.
    echo '. "/opt/conda/etc/profile.d/conda.sh"' >> $APPTAINER_ENVIRONMENT
    echo 'conda activate __apptainer-env__' >> $APPTAINER_ENVIRONMENT

%environment
    export PYTHONUNBUFFERED=1
    export PYTHONNOUSERSITE=1
